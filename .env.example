# Copy only a newly issued key into your shell environment. Never commit it here.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
IBS_DB_PATH=backend/iron-bottom-sound.sqlite3

# QQ / MCP service (leave SELF_ID empty to run MCP-only).
IBS_BOT_DATABASE=backend/bot.sqlite3
IBS_ONEBOT_SELF_ID=
IBS_ALLOWED_GROUPS=
IBS_ONEBOT_API_URL=http://127.0.0.1:3000
IBS_ONEBOT_SECRET=
IBS_ONEBOT_TOKEN=
IBS_AGENT_IDENTITIES={}
# Each MCP process receives its own IBS_AGENT_TOKEN; never share it in a tool argument.
IBS_BOT_URL=http://127.0.0.1:3192

# Official QQ Bot (AppID/AppSecret, no personal QQ account login).
# Keep allowed groups empty for authenticated group-ID discovery only.
IBS_QQ_APP_ID=
IBS_QQ_APP_SECRET=
IBS_QQ_ALLOWED_GROUPS=
# Optional fixed identity selected by the SSH blue/red launchers.
IBS_MCP_BLUE_IDENTITY=agent:blue
IBS_MCP_RED_IDENTITY=agent:red
