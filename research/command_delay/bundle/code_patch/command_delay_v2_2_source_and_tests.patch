+def test_doctrine_supplies_a_fallback_hierarchy_only_when_directives_exist() -> None:
+    engine, state = start()
+    while state.phase != Phase.GUNNERY:
+        if state.phase == Phase.COMPLETE:
+            pytest.skip("scenario completed before a gunnery phase")
+        step(engine, state)
